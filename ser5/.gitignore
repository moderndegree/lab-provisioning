# ─── Operator-specific local files — NEVER commit these ──────────────────────
# These are generated by make init / make render and hold real values.
.bootstrap.env
autoinstall/user-data
ansible/inventory.ini
ansible/group_vars/all.yml
ansible/group_vars/vault.yml

# ─── Vault password files — NEVER commit ─────────────────────────────────────
.vault_pass
vault_password_file
*.vault_pass

# ─── Ansible runtime ──────────────────────────────────────────────────────────
*.retry
.ansible/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/
*.swp
*~
