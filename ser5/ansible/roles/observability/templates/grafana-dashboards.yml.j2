# Grafana dashboard provider — provisioned by Ansible, do not edit by hand.
# Grafana loads this from /etc/grafana/provisioning/dashboards/ at startup.
apiVersion: 1
providers:
  - name: lab
    orgId: 1
    folder: Lab
    type: file
    disableDeletion: false
    updateIntervalSeconds: 30
    allowUiUpdates: true
    options:
      path: /etc/grafana/provisioning/dashboards/json
      foldersFromFilesStructure: false
