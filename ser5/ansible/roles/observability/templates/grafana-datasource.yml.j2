# Grafana Prometheus datasource — provisioned by Ansible, do not edit by hand.
# Grafana loads this from /etc/grafana/provisioning/datasources/ at startup.
# Dashboards are file-provisioned next to this (provisioning/dashboards/).
apiVersion: 1
datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    # Container-name DNS within the 'obs' Podman network (both containers joined).
    url: "http://prometheus:{{ prometheus_port }}"
    isDefault: true
    editable: false
