# Prometheus scrape config — managed by Ansible, do not edit by hand.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  # mini system + GPU metrics (prometheus-node-exporter)
  # hwmon collector → GPU temps, power draw
  # drm collector   → AMDGPU utilization, VRAM/GTT usage (enabled via ARGS in
  #                   /etc/default/prometheus-node-exporter on mini)
  - job_name: mini-node
    static_configs:
      - targets:
          - "{{ mini_host }}:{{ mini_node_exporter_port }}"
        labels:
          instance: mini

  # mini llama.cpp inference metrics (tokens/s, active requests, queue depth,
  # KV cache usage). llama-server exposes /metrics only with --metrics, which
  # mini's llamacpp_base_args sets. One job per instance so the `instance` label
  # distinguishes them — they serve different models with different sizing.
  #
  # This replaced a commented-out Ollama scrape job in 2026-08: Ollama no longer
  # serves on this box, so those metrics would never have arrived.
  - job_name: mini-llamacpp
    static_configs:
      - targets:
          - "{{ mini_host }}:8090"
        labels:
          instance: mini-quality
      - targets:
          - "{{ mini_host }}:8091"
        labels:
          instance: mini-throughput
  #       labels:
  #         instance: mini
  #     metrics_path: /metrics
