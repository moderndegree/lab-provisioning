# systemd SYSTEM unit — load the locality ruleset.
# Managed by ser5/ansible/roles/voice — do not edit by hand.
#
# A oneshot that loads its own nftables table and nothing else. UFW is left
# entirely alone: this adds `table inet {{ voice_locality_table }}` beside
# whatever UFW has, and removing it is one `nft delete table`.
#
# Ordered after ufw so a UFW reload cannot flush it, and RemainAfterExit so
# `systemctl status` shows the intent. NOTE the failure mode that shape has —
# roles/observability has already been bitten by it: a oneshot reports
# `active (exited)` forever, whether or not the thing it created still exists.
# So verify.yml does not ask systemd. It opens a socket and checks it is
# refused.
[Unit]
Description=Voice locality — the presence may reach the property, not the world
After=ufw.service nftables.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f {{ voice_locality_ruleset }}
ExecStop=/usr/sbin/nft delete table inet {{ voice_locality_table }}

[Install]
WantedBy=multi-user.target
