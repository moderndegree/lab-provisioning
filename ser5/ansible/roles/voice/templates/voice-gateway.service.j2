# systemd USER unit — voice gateway.
# Managed by ser5/ansible/roles/voice — do not edit by hand.
#
# NOT a container, deliberately. The gateway shells out to `hermes` for
# delegation, so containerising it would mean baking the Hermes binary and
# HERMES_HOME into an image and keeping them in step with roles/hermes forever.
# roles/hermes is the precedent for a user unit with an explicit PATH.
#
# Every setting the gateway reads arrives as an environment variable below, so
# this file is the whole story:
#   systemctl --user show voice-gateway -p Environment

[Unit]
Description=Voice gateway — VAD, STT, mini, TTS, with barge-in
After=network-online.target voice-speech.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ voice_app_dir }}
Environment=PATH={{ voice_gateway_path }}
Environment=PYTHONUNBUFFERED=1

Environment=VOICE_HOST={{ voice_gateway_host }}
Environment=VOICE_PORT={{ voice_gateway_port }}

# voice_stt_backend: "ser5" (this box, CPU) or "mini" (GPU, ~33-51ms measured
# vs ser5's 671ms — see roles/whispercpp/defaults/main.yml). Toggle there, not
# here.
Environment=VOICE_STT_URL={{ voice_stt_url }}
Environment=VOICE_STT_MODEL={{ voice_stt_model }}
Environment=VOICE_STT_LANGUAGE={{ voice_stt_language }}

# Same service as STT today. Kept as its own variable so a voice-clone lane on
# the workstation GPU can be pointed at without touching STT.
Environment=VOICE_TTS_URL=http://{{ voice_speech_host }}:{{ voice_speech_port }}
Environment=VOICE_TTS_MODEL={{ voice_tts_model }}
Environment=VOICE_TTS_VOICE={{ voice_tts_voice }}

Environment=VOICE_LLM_BASE_URL={{ voice_llm_base_url }}
Environment=VOICE_LLM_MODEL={{ voice_llm_model }}
Environment=VOICE_LLM_MAX_TOKENS={{ voice_llm_max_tokens }}

Environment=VOICE_VAD_MODEL_PATH={{ voice_vad_model_path }}
Environment=VOICE_VAD_SILENCE_MS={{ voice_vad_silence_ms }}

# The Ledger. WAL-mode SQLite under {{ voice_data_dir }}, which restic already
# covers. A gateway that cannot open it still comes up and still talks — it just
# does not remember, and /v1/status refuses to call itself ok. See
# defaults/main.yml for why attribution is recorded from day one.
Environment=VOICE_LEDGER_PATH={{ voice_ledger_path }}
Environment=VOICE_VAULT_DIR={{ voice_vault_dir }}
Environment=VOICE_RESULT_TTL_S={{ voice_result_ttl_s }}

# false = the presence refuses anything needing the world, out loud, instead of
# reaching for it. Toggle in defaults/main.yml, not here.
Environment=VOICE_PRESENCE_NETWORK={{ voice_presence_network | bool | lower }}
# The presence only DISPATCHES an errand when a bench exists to pick the brief
# up. False and it refuses out loud instead — which is honest, and is why this is
# the same flag that deploys voice-bench.service rather than a second one that
# could disagree with it.
Environment=VOICE_BENCH_ENABLED={{ enable_voice_bench | bool | lower }}

# Spoken commands that act on the box. The shipped registry is read-only, so this
# is not protecting against the actions — it is protecting against the idea.
# Irreversible actions are DECLARED in voice_gateway/hands/registry.py and always
# get a spoken confirmation, because permission cannot answer the question voice
# actually raises: not "are you allowed", but "did you say it".
Environment=VOICE_HANDS_ENABLED={{ enable_voice_hands | default(false) | bool | lower }}

# Whether egress from THIS process is supposed to be impossible. The presence
# tests it on itself and reports on /v1/status, because it is the only process
# in the cgroup the nftables rule names — an external probe cannot get into that
# cgroup without root, and the obvious `nsenter --cgroup` does not put it there
# at all (it enters the cgroup NAMESPACE and leaves the process where it was).
Environment=VOICE_LOCALITY_ENFORCED={{ voice_locality_enforce | bool | lower }}

# How long the presence holds the GPU against the bench, refreshed while it has
# the floor. See defaults/main.yml for the measurement that made this necessary:
# one errand in flight cost the presence 861ms -> 2451ms to first audible word.
Environment=VOICE_FLOOR_HOLD_S={{ voice_floor_hold_s }}
Environment=VOICE_SEARXNG_URL={{ voice_searxng_url }}
Environment=VOICE_HERMES_BIN={{ voice_hermes_bin }}
# The system prompt lives in the repo and is byte-stable across restarts. That
# matters beyond tidiness: it is the prefix-cache key on mini, and the llamacpp
# defaults call --cache-ram the highest-value untuned knob on the box at ~12x on
# time-to-first-token. Measured here 2026-08-30: 774ms cold, 75ms warm.
Environment=VOICE_SYSTEM_PROMPT_PATH={{ voice_data_dir }}/system-prompt.md

ExecStart={{ voice_venv_dir }}/bin/python -m voice_gateway
{% if voice_locality_enforce | bool %}
# REBUILD THE WALL. `nft` resolves the cgroup path to an inode at load time, and
# systemd gives this service a NEW cgroup inode on every start — so a rule loaded
# before this moment matches nothing, while still printing the right path in
# `nft list ruleset`. Re-loading it here, after the cgroup exists, is what makes
# locality survive a restart, a converge and a reboot.
#
# `-` prefix: the presence must still come up if this fails. /v1/status reports
# the truth either way, which is the point of it testing itself.
# `sudo -n`: fails immediately rather than hanging if the sudoers drop-in is gone.
ExecStartPost=-/usr/bin/sudo -n /usr/bin/systemctl restart {{ voice_locality_unit }}
{% endif %}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
