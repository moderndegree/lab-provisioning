# Podman quadlet unit — Cloudflare Zero Trust tunnel (managed by Ansible)
# Documentation: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
# Cloudflare tunnel docs: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/

[Unit]
Description=Cloudflare Zero Trust Tunnel
After=network-online.target
Wants=network-online.target

[Container]
Image={{ cloudflared_image }}
ContainerName=cloudflared
# Host networking (NOT the default Podman bridge): origin services (Open WebUI,
# Hermes dashboard/proxy, Grafana) bind to 127.0.0.1 on the host's real network
# stack, not into any container network namespace — "http://localhost:<port>"
# ingress rules in the Zero Trust dashboard need Network=host to resolve there
# instead of cloudflared's own loopback. It also sidesteps ser5's default-deny
# UFW routed/forward policy, which otherwise blocks the isolated bridge
# network's outbound DNS/HTTPS entirely (confirmed live: without this, the
# container's DNS lookups to the LAN resolver and Cloudflare's edge both
# timed out, crash-looping the tunnel). Same fix already applied on mini.
Network=host
# Connector token (TUNNEL_TOKEN) sourced from a root-only env file, not inlined
# here — this quadlet is world-readable (0644).
EnvironmentFile=/etc/cloudflared/token.env
# `--no-autoupdate` disables cloudflared's *binary* self-update; image updates are
# handled by Podman (see AutoUpdate below) so versions stay reproducible.
Exec=tunnel --no-autoupdate run
{% if cloudflared_autoupdate | bool %}
# Pull a newer image on `podman auto-update` (podman-auto-update.timer).
AutoUpdate=registry
{% endif %}

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
# Quadlet enables the generated service at boot via this section.
WantedBy=multi-user.target default.target
