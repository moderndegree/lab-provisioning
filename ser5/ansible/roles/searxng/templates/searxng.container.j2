# Podman quadlet — SearXNG (rootless, Ansible-managed).
# Open WebUI web-search backend on the same bridge as openwebui.
# Loopback only. The Tailscale address is owned by searxng-tailnet.service,
# which refuses the JSON API and the image fetcher. Never 0.0.0.0 — that
# would put this on the LAN, and no UFW rule is expected to catch it.

[Unit]
Description=SearXNG (Open WebUI web search)
After=network-online.target openwebui-network.service
Wants=network-online.target

[Container]
Image={{ searxng_image }}
ContainerName=searxng
Network=openwebui.network
UserNS=keep-id
PublishPort={{ searxng_host }}:{{ searxng_port }}:8080
Volume={{ searxng_data_dir }}:/etc/searxng:Z
Environment=SEARXNG_BASE_URL=http://ser5:{{ searxng_port }}/
{% if searxng_autoupdate | bool %}
AutoUpdate=registry
{% endif %}

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
