#!/usr/bin/env bash
# {{ ansible_managed }}
# Interactive quality gate for Hermes / operators. Wraps `qloop gate`.
# Warm models only; free-text / no-tool-oracle tasks — not code diffs.
#
# Usage:
#   quality-gate.sh --task "…" [--baseline "…"] [--strategy refine|single|best_of_n]
#                   [--worker general|coder] [--playbook PATH] [--rounds 2]
set -euo pipefail

export QUALITY_LOOP_DATA="${QUALITY_LOOP_DATA:-{{ agentlab_root }}}"
export QUALITY_LOOP_BASE_URL="${QUALITY_LOOP_BASE_URL:-{{ agentlab_base_url }}}"
export LOOPKIT_DATA="${QUALITY_LOOP_DATA}"
export LOOPKIT_BASE_URL="${QUALITY_LOOP_BASE_URL}"

TASK=""
BASELINE=""
STRATEGY="refine"
WORKER="general"
JUDGE="general"
PLAYBOOK=""
ROUNDS="2"
N="3"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --task) TASK="${2:-}"; shift 2 ;;
    --baseline) BASELINE="${2:-}"; shift 2 ;;
    --strategy) STRATEGY="${2:-}"; shift 2 ;;
    --worker) WORKER="${2:-}"; shift 2 ;;
    --judge) JUDGE="${2:-}"; shift 2 ;;
    --playbook) PLAYBOOK="${2:-}"; shift 2 ;;
    --rounds) ROUNDS="${2:-}"; shift 2 ;;
    -n) N="${2:-}"; shift 2 ;;
    -h|--help)
      sed -n '2,12p' "$0"
      exit 0
      ;;
    *)
      echo "unknown arg: $1" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$TASK" ]]; then
  echo "usage: $0 --task \"…\" [--baseline \"…\"] [--strategy refine] …" >&2
  exit 1
fi

args=(gate --task "$TASK" --strategy "$STRATEGY" --worker "$WORKER" --judge "$JUDGE"
      --rounds "$ROUNDS" -n "$N" --json --timeout 180)
[[ -n "$BASELINE" ]] && args+=(--baseline "$BASELINE")
[[ -n "$PLAYBOOK" ]] && args+=(--playbook "$PLAYBOOK")

exec qloop "${args[@]}"
