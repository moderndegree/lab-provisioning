# Podman quadlet unit — Open WebUI (rootless, managed by Ansible)
# https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
# Open WebUI docs: https://docs.openwebui.com/

[Unit]
Description=Open WebUI
After=network-online.target
Wants=network-online.target

[Container]
Image={{ openwebui_image }}
ContainerName=openwebui
Network=openwebui.network
# mini is a different physical machine, reached over the tailnet — DNSSearch=
# is what makes "mini" resolve here (Tailscale MagicDNS suffix).
DNSSearch={{ tailnet_dns_search }}
Environment=OLLAMA_BASE_URL={{ openwebui_ollama_base_url }}
# llama-server speaks the OpenAI API, not Ollama's, so it needs its own wiring — see
# openwebui_openai_base_urls in defaults/main.yml. Plural *_URLS/*_KEYS is the
# multi-endpoint form; the lists are positional and an empty key drops that
# endpoint silently.
Environment=ENABLE_OPENAI_API={{ openwebui_enable_openai_api | lower }}
Environment=OPENAI_API_BASE_URLS={{ openwebui_openai_base_urls }}
Environment=OPENAI_API_KEYS={{ openwebui_openai_api_keys }}
# Persisted WEBUI_SECRET_KEY (see tasks/main.yml) — keeps sessions valid across
# container restarts/updates.
EnvironmentFile={{ openwebui_env_file }}
Environment=ENABLE_SIGNUP={{ openwebui_enable_signup | lower }}
# Loopback by default — see openwebui_host in defaults/main.yml for the remote-
# access story (tailscale serve / Cloudflare tunnel), which mirrors Grafana's.
PublishPort={{ openwebui_host }}:{{ openwebui_port }}:8080
Volume={{ openwebui_data_dir }}:/app/backend/data:Z
{% if openwebui_autoupdate | bool %}
AutoUpdate=registry
{% endif %}

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
