[Unit]
Description=Hermes Agent Gateway
Documentation=https://hermes-agent.nousresearch.com/docs/user-guide/messaging
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
Environment=HOME={{ user_home }}
Environment=HERMES_HOME={{ hermes_home }}
# Include ~/.grok/bin so the optional Grok Build skill can spawn `grok`.
Environment=PATH={{ hermes_path }}
# NO OLLAMA_BASE_URL here. Inference routing lives in HERMES_HOME/config.yaml
# (model.provider/base_url/default), applied by the role with `hermes config set`.
# Upstream removed the legacy env-var path, so a value here would be silently
# ignored — and the one that used to be here pointed at mini:11434, an Ollama
# that has been stopped since llama-server took its residency.
# HERMES_HOME/.env (optional XAI_API_KEY etc.) is loaded by Hermes itself.
ExecStart={{ hermes_bin }} gateway start --all
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
TimeoutStartSec=60

[Install]
WantedBy=default.target
