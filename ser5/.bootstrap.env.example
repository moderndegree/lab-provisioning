# .bootstrap.env — local-only; gitignored; single source of truth for make render
#
# Copy to .bootstrap.env (make init does this) and fill in real values.
# This file drives envsubst substitution of ${PLACEHOLDER} tokens in:
#   autoinstall/user-data.example → autoinstall/user-data
#   ansible/inventory.example.ini → ansible/inventory.ini
#
# Values here MUST stay in sync with ansible/group_vars/all.yml
# (username, hostname, locale, timezone, keyboard_layout).

# ─── Node identity ────────────────────────────────────────────────────────────
USERNAME=your_username
USER_FULL_NAME="Your Full Name"
HOSTNAME=ser5

# ─── Autoinstall credentials ──────────────────────────────────────────────────
# Password hash — generate with one of:
#   python3 -c "import crypt, getpass; print(crypt.crypt(getpass.getpass(), crypt.mksalt(crypt.METHOD_SHA512)))"
#   mkpasswd --method=sha-512    (apt install whois)
# Wrap in single quotes to prevent shell interpretation of $ characters.
PASSWORD_HASH='$$6$$rounds=4096$$CHANGEME_SALT$$CHANGEME_HASH'

# SSH public key — paste the full line from ~/.ssh/id_ed25519.pub (or equivalent)
SSH_PUBLIC_KEY="ssh-ed25519 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA your_comment"

# ─── Disk paths ───────────────────────────────────────────────────────────────
# Verify with: lsblk -d -o NAME,SIZE,MODEL,TRAN
# The OS disk will be WIPED by autoinstall. Confirm before proceeding.
OS_DISK=/dev/nvme0n1      # 500GB NVMe — OS target (autoinstall wipes this)
# DATA_DISK is handled by Ansible (storage role), not by autoinstall

# ─── Locale/keyboard ─────────────────────────────────────────────────────────
TIMEZONE=America/Chicago
LOCALE=en_US.UTF-8
KEYBOARD_LAYOUT=us

# ─── Wi-Fi (optional) ────────────────────────────────────────
# Set these to provision over Wi-Fi with no wired link. They configure:
#   - the installer's own Wi-Fi (best-effort — needs the adapter's firmware in
#     the installer; verify at install time), and
#   - a first-boot networkd netplan so Ansible can reach the box over Wi-Fi.
# The Ansible desktop role then hands Wi-Fi to NetworkManager.
# Must match wifi_ssid in ansible/group_vars/all.yml and vault_wifi_psk in vault.yml.
# Leave BOTH blank to install over wired ethernet (make render drops the Wi-Fi blocks).
WIFI_SSID=YOUR_WIFI_SSID
WIFI_PSK=YOUR_WIFI_PASSWORD

# ─── Ansible target ──────────────────────────────────────────────────────────
# IP address of ser5 after autoinstall completes.
# Check your router's DHCP table or run: ip addr show (from the target console)
HOST_IP=192.168.x.x
