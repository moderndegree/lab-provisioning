#cloud-config
# Ubuntu Server 26.04 LTS — unattended autoinstall (NoCloud / Subiquity).
#
# USE THE SERVER ISO — not the Desktop ISO. The ubuntu-desktop metapackage
# is intentionally absent here; the Ansible 'desktop' role installs GNOME
# on the live system for a clean, logged, repeatable install.
#
# ISO: ubuntu-26.04-live-server-amd64.iso (verify checksum before flashing)
# TODO: Confirm 26.04 Server ISO filename and SHA256 at https://releases.ubuntu.com/26.04/
#
# ─── How this file is used ────────────────────────────────────────────────────
# This is a TEMPLATE. ${PLACEHOLDER} tokens are substituted from .bootstrap.env
# by `make render` (uses envsubst). Never edit autoinstall/user-data directly.
#
# Workflow:
#   1. make init        → create .bootstrap.env from .bootstrap.env.example
#   2. Edit .bootstrap.env with real values
#   3. make render      → generates autoinstall/user-data (gitignored)
#   4. Validate:        cloud-init schema --config-file autoinstall/user-data
#   5. Flash USB:       See README "Creating the autoinstall USB"
#
# ─── Disk safety ──────────────────────────────────────────────────────────────
# ONLY the NVMe OS disk (${OS_DISK}) is referenced in this config.
# The 1TB SATA SSD data disk (/dev/sda) is intentionally absent —
# it is NEVER touched by autoinstall and will be mounted by Ansible.
#
# BEFORE PROCEEDING: boot the live ISO, open a shell, and run:
#   lsblk -d -o NAME,SIZE,MODEL,TRAN
# Confirm OS_DISK in .bootstrap.env matches the NVMe (not the SATA SSD).

autoinstall:
  version: 1

  locale: ${LOCALE}

  keyboard:
    layout: ${KEYBOARD_LAYOUT}
    variant: ""

  network:
    # Wi-Fi-only capable. Two independent paths give connectivity with no wired link:
    #   1. The installer itself attempts Wi-Fi via the wifis block below (best-effort;
    #      both links are optional so the install proceeds even if neither comes up
    #      — the base system installs from the ISO without a network).
    #   2. The late-command injects a systemd-networkd netplan into the installed
    #      system so it connects over Wi-Fi on FIRST BOOT, before NetworkManager
    #      exists, letting Ansible reach it. The desktop role then hands the adapter
    #      over to NetworkManager (the long-term owner of Wi-Fi on the workstation).
    # Wired (en*) is still accepted when present and takes over automatically.
    version: 2
    ethernets:
      all-en:
        match:
          name: "en*"
        dhcp4: true
        optional: true
    # >>> WIFI (this whole block is stripped by `make render` when WIFI_SSID is blank) >>>
    wifis:
      all-wl:
        match:
          name: "wl*"
        dhcp4: true
        optional: true
        access-points:
          "${WIFI_SSID}":
            password: "${WIFI_PSK}"
    # <<< WIFI <<<

  identity:
    hostname: ${HOSTNAME}
    realname: ""
    username: ${USERNAME}
    # Generate hash: python3 -c "import crypt,getpass; print(crypt.crypt(getpass.getpass(),crypt.mksalt(crypt.METHOD_SHA512)))"
    # Must match PASSWORD_HASH in .bootstrap.env AND vault_user_password_hash in vault.yml
    password: "${PASSWORD_HASH}"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "${SSH_PUBLIC_KEY}"

  packages:
    - openssh-server
    # wpa_supplicant is the WPA backend NetworkManager uses for Wi-Fi on the
    # installed desktop (the full OS has the firmware the installer lacks).
    - wpasupplicant
    # GNOME desktop is installed by Ansible (desktop role), not here.

  storage:
    # Explicit layout: only disk0 (${OS_DISK}) is referenced.
    # The SATA SSD is absent — autoinstall will not touch it.
    config:
      - type: disk
        id: disk0
        path: ${OS_DISK}
        ptable: gpt
        wipe: superblock-recursive
        grub_device: true
        preserve: false

      # EFI system partition — 1 GB (holds multiple kernel generations)
      - type: partition
        id: part-efi
        device: disk0
        number: 1
        size: 1G
        flag: boot
        grub_device: true
        preserve: false

      - type: format
        id: fmt-efi
        volume: part-efi
        fstype: fat32
        preserve: false

      - type: mount
        id: mnt-efi
        device: fmt-efi
        path: /boot/efi

      # Root partition — remainder of NVMe
      - type: partition
        id: part-root
        device: disk0
        number: 2
        size: -1
        preserve: false

      - type: format
        id: fmt-root
        volume: part-root
        fstype: ext4
        label: ubuntu-root
        preserve: false

      - type: mount
        id: mnt-root
        device: fmt-root
        path: /

  late-commands:
    # Ensure SSH daemon is enabled for Ansible to connect after reboot
    - curtin in-target -- systemctl enable ssh
    # Disable any autoinstall-default UFW rules; Ansible configures firewall
    - curtin in-target -- ufw disable || true
    # >>> WIFI-LATE (this list item is stripped by `make render` when WIFI_SSID is blank) >>>
    # Keep the installer's persistent netplan ethernet-only. Subiquity copies the
    # autoinstall network config (including the wifis block) to 00-installer-config.yaml
    # under systemd-networkd; left there it would claim the Wi-Fi adapter via a udev
    # rule and block NetworkManager. Rewriting it to ethernet-only keeps Wi-Fi in the
    # single removable 90-wifi.yaml below, so the desktop role's hand-off to
    # NetworkManager is clean. (Ethernet stays as a first-boot fallback.)
    - |
      cat > /target/etc/netplan/00-installer-config.yaml <<'NETCFG'
      network:
        version: 2
        ethernets:
          all-en:
            match:
              name: "en*"
            dhcp4: true
            optional: true
      NETCFG
      chmod 600 /target/etc/netplan/00-installer-config.yaml
    # Inject a systemd-networkd Wi-Fi netplan so the installed server connects over
    # Wi-Fi on FIRST BOOT — before NetworkManager is installed — so Ansible can reach
    # it with no wired link. The desktop role removes this file and hands the adapter
    # to NetworkManager during the first converge. ${WIFI_SSID}/${WIFI_PSK} are
    # substituted at render time by envsubst.
    - |
      cat > /target/etc/netplan/90-wifi.yaml <<'NETPLAN'
      network:
        version: 2
        wifis:
          wl-all:
            match:
              name: "wl*"
            dhcp4: true
            optional: true
            access-points:
              "${WIFI_SSID}":
                password: "${WIFI_PSK}"
      NETPLAN
      chmod 600 /target/etc/netplan/90-wifi.yaml
    # <<< WIFI-LATE <<<

  updates: security
  shutdown: reboot
