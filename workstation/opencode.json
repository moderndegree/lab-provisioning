{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "quality": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://mini:8090/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "qwen3.6-35b-a3b-mtp": {
          "name": "Qwen3.6 35B-A3B MTP (quality — 88 t/s solo, MTP +21%)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "throughput": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://mini:8091/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "gpt-oss-20b": {
          "name": "gpt-oss 20B (throughput — 33 t/s x4 parallel, 114 agg)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "github-copilot": {},
    "xai": {}
  },
  "model": "quality/qwen3.6-35b-a3b-mtp",
  "small_model": "throughput/gpt-oss-20b",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "reserved": 8192
  },
  "instructions": [
    "AGENTS.md",
    ".moderndegree/skills/*.md"
  ],
  "mcp": {
    "cortex": {
      "type": "local",
      "command": [
        "pnpm",
        "--dir",
        "/home/brian/projects/ai-workstation",
        "mcp"
      ],
      "environment": {
        "CORTEX_VAULT_DIR": "/data/brain"
      },
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "reasoningEffort": "none",
      "description": "Orchestrator. Cortex vault search + TASK PACKAGE, dispatches subagents, @@RESULT gates.",
      "prompt": "{file:./.moderndegree/prompts/orchestrator.md}"
    },
    "planner": {
      "mode": "subagent",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "description": "Produces an implementation plan from context provided in-prompt. Reasoning only.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/planner.md}"
    },
    "architect": {
      "mode": "subagent",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "description": "Designs structure and interfaces from provided context. Reasoning only.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/architect.md}"
    },
    "coder": {
      "mode": "subagent",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "description": "Implements changes. Edits files, verifies they parse/build. Runs on the QUALITY endpoint — code correctness is worth more than parallelism here.",
      "prompt": "{file:./.moderndegree/prompts/coder.md}"
    },
    "devops": {
      "mode": "subagent",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "reasoningEffort": "none",
      "description": "Infra and shell operations. Deterministic, no reasoning.",
      "prompt": "{file:./.moderndegree/prompts/devops.md}"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "throughput/gpt-oss-20b",
      "description": "Critiques diffs handed to it. Reasoning only. FAN-OUT agent — runs on :8091 so it can go in parallel with the other critics.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/reviewer.md}"
    },
    "security-auditor": {
      "mode": "subagent",
      "model": "throughput/gpt-oss-20b",
      "description": "Audits provided diffs for security issues. Reasoning only. FAN-OUT agent.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/security.md}"
    },
    "tester": {
      "mode": "subagent",
      "model": "throughput/gpt-oss-20b",
      "description": "Writes and runs tests, reads results. FAN-OUT agent.",
      "prompt": "{file:./.moderndegree/prompts/tester.md}"
    },
    "doc-writer": {
      "mode": "subagent",
      "model": "throughput/gpt-oss-20b",
      "description": "Writes docs from provided material. Reasoning only. FAN-OUT agent.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/docs.md}"
    },
    "deep": {
      "mode": "subagent",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "description": "Hard-reasoning escalation on the QUALITY endpoint with thinking left ON. Replaces the old `heavy` agent, which pointed at gpt-oss:120b via Ollama and no longer resolves. Costs a quality slot — do not call in a loop.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/planner.md}"
    },
    "research": {
      "mode": "subagent",
      "model": "xai/grok-build-0.1",
      "description": "Tier X. Live web research via xAI. NEVER give this agent client-confidential material.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/planner.md}"
    }
  }
}
