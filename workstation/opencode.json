{
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://mini:11434/v1"
      },
      "models": {
        "qwen3-coder-next:latest": {
          "name": "Qwen3-Coder-Next 80B-A3B (MoE — coding + deep reasoning)",
          "options": {
            "stream": false
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "qwen3.6:35b-a3b-mtp-q4_K_M": {
          "name": "Qwen3.6 35B-A3B (MoE — general + orchestration)",
          "options": {
            "stream": false
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "gpt-oss:120b": {
          "name": "gpt-oss 120B-A5.1B (MoE — heavy tier, EVICTS a warm model)",
          "options": {
            "stream": false
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "github-copilot": {},
    "xai": {}
  },
  "model": "ollama/qwen3.6:35b-a3b-mtp-q4_K_M",
  "small_model": "ollama/qwen3.6:35b-a3b-mtp-q4_K_M",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "reserved": 8192
  },
  "instructions": [
    "AGENTS.md",
    ".moderndegree/skills/*.md"
  ],
  "mcp": {
    "cortex": {
      "type": "local",
      "command": [
        "pnpm",
        "--dir",
        "/home/brian/projects/ai-workstation",
        "mcp"
      ],
      "environment": {
        "CORTEX_VAULT_DIR": "/data/brain"
      },
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "ollama/qwen3.6:35b-a3b-mtp-q4_K_M",
      "reasoningEffort": "none",
      "description": "Orchestrator. Cortex vault search + TASK PACKAGE, dispatches subagents, @@RESULT gates.",
      "prompt": "{file:./.moderndegree/prompts/orchestrator.md}"
    },
    "planner": {
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:latest",
      "description": "Produces an implementation plan from context provided in-prompt. Reasoning only.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/planner.md}"
    },
    "architect": {
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:latest",
      "description": "Designs structure and interfaces from provided context. Reasoning only.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/architect.md}"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:latest",
      "description": "Critiques diffs handed to it. Reasoning only.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/reviewer.md}"
    },
    "security-auditor": {
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:latest",
      "description": "Audits provided diffs for security issues. Reasoning only.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/security.md}"
    },
    "doc-writer": {
      "mode": "subagent",
      "model": "ollama/qwen3.6:35b-a3b-mtp-q4_K_M",
      "description": "Writes docs from provided material. Reasoning only.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/docs.md}"
    },
    "coder": {
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:latest",
      "description": "Implements changes. Edits files, verifies they parse/build.",
      "prompt": "{file:./.moderndegree/prompts/coder.md}"
    },
    "tester": {
      "mode": "subagent",
      "model": "ollama/qwen3-coder-next:latest",
      "description": "Writes and runs tests, reads results.",
      "prompt": "{file:./.moderndegree/prompts/tester.md}"
    },
    "devops": {
      "mode": "subagent",
      "model": "ollama/qwen3.6:35b-a3b-mtp-q4_K_M",
      "reasoningEffort": "none",
      "description": "Infra and shell operations. Deterministic, no reasoning.",
      "prompt": "{file:./.moderndegree/prompts/devops.md}"
    },
    "heavy": {
      "mode": "subagent",
      "model": "ollama/gpt-oss:120b",
      "description": "Tier L escalation for genuinely hard reasoning. EVICTS a warm model on mini — invoke deliberately, never in a tight loop. Reasoning only.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/planner.md}"
    },
    "research": {
      "mode": "subagent",
      "model": "xai/grok-build-0.1",
      "description": "Tier X. Live web research via xAI. NEVER give this agent client-confidential material.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/planner.md}"
    }
  }
}
