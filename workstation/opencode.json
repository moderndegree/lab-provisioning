{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "quality": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://mini:8090/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "qwen3.6-35b-a3b-mtp": {
          "name": "Qwen3.6 35B-A3B MTP (quality — 262144 ctx, 2 slots, MTP +21% solo)",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        }
      }
    },
    "throughput": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://mini:8091/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "gpt-oss-20b": {
          "name": "gpt-oss 20B (throughput — 33 t/s x4 parallel, 114 agg)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "github-copilot": {},
    "xai": {}
  },
  "model": "quality/qwen3.6-35b-a3b-mtp",
  "small_model": "throughput/gpt-oss-20b",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "reserved": 8192
  },
  "instructions": [
    "AGENTS.md",
    ".moderndegree/skills/*.md"
  ],
  "mcp": {
    "cortex": {
      "type": "local",
      "command": [
        "/home/blewis/projects/ai-workstation/node_modules/.bin/tsx",
        "/home/blewis/projects/ai-workstation/mcp/cortex-server.ts"
      ],
      "environment": {
        "CORTEX_VAULT_DIR": "/data/brain"
      },
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "patch": "deny",
        "bash": "deny",
        "cortex_vault_search": "deny",
        "cortex_vault_get_note": "deny",
        "cortex_vault_list_notes": "deny",
        "cortex_vault_backlinks": "deny",
        "cortex_vault_local_graph": "deny",
        "cortex_vault_stats": "deny",
        "cortex_vault_capture": "deny",
        "list_mcp_resources": "deny",
        "read_mcp_resource": "deny",
        "list_mcp_resource_templates": "deny"
      },
      "description": "Orchestrator. Routes work; does NOT do it. DO NOT add reasoningEffort:'none' here — measured 2026-08-05, it drops subagent dispatches to ZERO (the model stops deciding to delegate). The edit/write/patch/bash denials are load-bearing too: with prose alone the no-implementation rule held on some runs and not others.",
      "prompt": "{file:./.moderndegree/prompts/orchestrator.md}"
    },
    "planner": {
      "mode": "subagent",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "description": "Produces an implementation plan from context provided in-prompt. Reasoning only.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow"
      },
      "prompt": "{file:./.moderndegree/prompts/planner.md}"
    },
    "architect": {
      "mode": "subagent",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "description": "Designs structure and interfaces from provided context. Reasoning only.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow"
      },
      "prompt": "{file:./.moderndegree/prompts/architect.md}"
    },
    "coder": {
      "mode": "subagent",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "description": "Implements changes. Edits files, verifies they parse/build. Runs on the QUALITY endpoint — code correctness is worth more than parallelism here.",
      "prompt": "{file:./.moderndegree/prompts/coder.md}",
      "permission": {
        "external_directory": "allow"
      }
    },
    "devops": {
      "mode": "subagent",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "reasoningEffort": "none",
      "description": "Infra and shell operations. Deterministic, no reasoning.",
      "prompt": "{file:./.moderndegree/prompts/devops.md}",
      "permission": {
        "external_directory": "allow"
      }
    },
    "reviewer": {
      "mode": "subagent",
      "model": "throughput/gpt-oss-20b",
      "description": "Critiques diffs handed to it. Reasoning only. FAN-OUT agent — runs on :8091 so it can go in parallel with the other critics.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow"
      },
      "prompt": "{file:./.moderndegree/prompts/reviewer.md}"
    },
    "security-auditor": {
      "mode": "subagent",
      "model": "throughput/gpt-oss-20b",
      "description": "Audits provided diffs for security issues. Reasoning only. FAN-OUT agent.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow"
      },
      "prompt": "{file:./.moderndegree/prompts/security.md}"
    },
    "tester": {
      "mode": "subagent",
      "model": "throughput/gpt-oss-20b",
      "description": "Writes and runs tests, reads results. FAN-OUT agent.",
      "prompt": "{file:./.moderndegree/prompts/tester.md}",
      "permission": {
        "external_directory": "allow"
      }
    },
    "doc-writer": {
      "mode": "subagent",
      "model": "throughput/gpt-oss-20b",
      "description": "Writes docs from provided material. Reasoning only. FAN-OUT agent.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow"
      },
      "prompt": "{file:./.moderndegree/prompts/docs.md}"
    },
    "qa": {
      "mode": "subagent",
      "model": "throughput/gpt-oss-20b",
      "description": "Final acceptance gate. Runs the delivered system against its DONE-WHEN list black-box, with real dependencies, and pastes actual output per criterion. Distinct from tester: tester proves the logic, qa proves the thing works. Runs AFTER the critic fan-out, not inside it.",
      "prompt": "{file:./.moderndegree/prompts/qa.md}",
      "permission": {
        "external_directory": "allow",
        "cortex_vault_capture": "allow",
        "cortex_vault_search": "allow",
        "cortex_vault_stats": "allow"
      }
    },
    "librarian": {
      "mode": "subagent",
      "model": "throughput/gpt-oss-20b",
      "description": "Second brain. RECALL: searches the cortex vault for prior lessons before work starts. CAPTURE: records a lesson after a run with a real miss. The ONLY agent with vault tools — the orchestrator is denied them, because measured 2026-08-05 a prose \"cortex pass\" never fired once while a dispatch does.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "cortex_vault_search": "allow",
        "cortex_vault_get_note": "allow",
        "cortex_vault_list_notes": "allow",
        "cortex_vault_stats": "allow",
        "cortex_vault_capture": "allow",
        "cortex_vault_backlinks": "allow",
        "cortex_vault_local_graph": "allow"
      },
      "prompt": "{file:./.moderndegree/prompts/librarian.md}"
    },
    "deep": {
      "mode": "subagent",
      "model": "quality/qwen3.6-35b-a3b-mtp",
      "description": "Hard-reasoning escalation on the QUALITY endpoint with thinking left ON. Replaces the old `heavy` agent, which pointed at gpt-oss:120b via Ollama and no longer resolves. Costs a quality slot — do not call in a loop.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow"
      },
      "prompt": "{file:./.moderndegree/prompts/planner.md}"
    },
    "research": {
      "mode": "subagent",
      "model": "xai/grok-build-0.1",
      "description": "Tier X. Live web research via xAI. NEVER give this agent client-confidential material.",
      "permission": {
        "*": "deny"
      },
      "prompt": "{file:./.moderndegree/prompts/planner.md}"
    }
  }
}
