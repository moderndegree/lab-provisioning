---
# Ansible Vault secret stubs for mini.
# This file (vault.yml.example) is tracked with placeholder values.
# vault.yml (the real file with secrets) is gitignored.
#
# ─── First-time setup ─────────────────────────────────────────────────────────
#   1. make init           → copies this file to ansible/group_vars/vault.yml
#   2. Edit vault.yml      → fill in real values (see notes below)
#   3. make vault-encrypt  → encrypts vault.yml in-place with ansible-vault
#
# ─── Generating values ────────────────────────────────────────────────────────
# Tailscale auth key:
#   https://login.tailscale.com/admin/settings/keys
#   Use a reusable or one-off key tagged for mini.

# Tailscale ephemeral auth key (from Tailscale admin console → Settings → Keys)
vault_tailscale_authkey: "tskey-auth-PLACEHOLDER"

# Cloudflare Tunnel connector token (Zero Trust dashboard → Networks → Tunnels →
# Create a tunnel → Cloudflared). The cloudflared role only starts the tunnel
# when this is non-empty and does not begin with "PLACEHOLDER" — safe to leave
# as-is until you need it.
vault_cloudflared_token: "PLACEHOLDER_CLOUDFLARED_TOKEN"

# HuggingFace read token (https://huggingface.co/settings/tokens). ONLY needed
# for gated repos — meta-llama/*, google/gemma-*, and friends — where you must
# also accept the licence on the model page. Everything else downloads without
# it, and `hf auth login` on mini is an equivalent alternative. The llamacpp
# role writes no token file while this is empty or still a PLACEHOLDER.
vault_hf_token: "PLACEHOLDER_HF_TOKEN"