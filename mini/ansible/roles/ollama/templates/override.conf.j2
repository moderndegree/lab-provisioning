[Service]
# Ollama environment overrides for mini (MS-S1 Max, gfx1151, 128 GB unified RAM)

# GLOBAL context window — the /v1 endpoint cannot set num_ctx per request, so
# this is the window every loaded model gets. Sized in group_vars/all.yml
# against the KV-cache budget of the two warm base models (see comments there).
# Prefill is the wall at ~205 t/s — a fully-packed 256K prompt costs ~21 min
# before first token; the window is capacity, not a target.
Environment="OLLAMA_CONTEXT_LENGTH={{ ollama_context_length }}"

Environment="OLLAMA_NUM_PARALLEL={{ ollama_num_parallel }}"
Environment="OLLAMA_FLASH_ATTENTION={{ ollama_flash_attention }}"
Environment="OLLAMA_KV_CACHE_TYPE={{ ollama_kv_cache_type }}"
Environment="OLLAMA_MAX_LOADED_MODELS={{ ollama_max_loaded_models }}"

# The warm pair (qwen3.6 27b + 35b-a3b base models) stays pinned across
# handoffs with KEEP_ALIVE=-1. MAX_LOADED_MODELS=2 means running any third
# model evicts one of the pair — deliberate: the pair IS the fleet.
Environment="OLLAMA_KEEP_ALIVE={{ ollama_keep_alive }}"

# Keep the integrated GPU. Strix Halo enumerates as an iGPU and Ollama drops
# integrated devices by default ("to enable, set OLLAMA_IGPU_ENABLE=1") — on BOTH
# the ROCm and Vulkan paths. Master switch that lets the device survive discovery.
Environment="OLLAMA_IGPU_ENABLE=1"

# Bind address + model store. systemd services do NOT read /etc/environment, so
# these must live here in the unit override to actually reach the ollama process.
Environment="OLLAMA_HOST={{ ollama_host }}"
Environment="OLLAMA_MODELS={{ data_mount }}/ollama"
{% if gpu_backend == "vulkan" %}

# --- Vulkan (committed path) ---
# Committed to Vulkan/RADV on mini: measured +7–26% decode vs ROCm. HIP is turned
# OFF here so Ollama selects the Vulkan backend instead of bundled ROCm.
Environment="OLLAMA_VULKAN=1"
Environment="HIP_VISIBLE_DEVICES=-1"
Environment="AMD_VULKAN_ICD={{ ollama_vulkan_icd }}"

# --- ROCm fallback (DISABLED while HIP is off above) ---
# The amdgpu_rocm role still installs the ROCm stack as a fallback. To revert, set
# gpu_backend: rocm in group_vars/all.yml and re-run make provision — this file
# regenerates automatically. The lines below are dead config on the Vulkan path
# and are shown only to document the revert target:
# Environment="HSA_OVERRIDE_GFX_VERSION={{ hsa_override_gfx_version }}"
# Environment="HSA_ENABLE_SDMA=0"
# Environment="HSA_USE_SVM=0"
{% elif gpu_backend == "rocm" %}

# --- ROCm (committed path) ---
# Required for gfx1151 — Strix Halo is NOT on AMD's official ROCm support matrix.
# HSA_OVERRIDE_GFX_VERSION tricks ROCm into the closest supported target.
Environment="HSA_OVERRIDE_GFX_VERSION={{ hsa_override_gfx_version }}"
# Legacy gfx1151 hang workarounds — likely unneeded on kernel 7.0. Uncomment only
# if you observe ROCm hangs after a kernel/ROCm bump:
# Environment="HSA_ENABLE_SDMA=0"
# Environment="HSA_USE_SVM=0"
{% endif %}
