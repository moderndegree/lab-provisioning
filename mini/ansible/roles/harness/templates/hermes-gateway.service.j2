[Unit]
Description=Hermes Agent Gateway
Documentation=https://hermes-agent.nousresearch.com/docs/user-guide/messaging
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Hermes' system-level gateway requires root (see `hermes gateway start --system`).
# Runs as root, but HOME/HERMES_HOME still point at the node user's config + data.
User=root
Group=root
Environment=HOME={{ node_home }}
Environment=HERMES_HOME={{ hermes_home }}
# Secrets (LLM provider API key, etc.) sourced from vault-managed environment file.
# The leading dash means systemd ignores a missing file (graceful degradation).
EnvironmentFile=-/etc/hermes/environment
# --system: run the Linux system-level gateway service.
# --all:    clear any stale gateway processes before starting (avoids restart loops).
ExecStart={{ hermes_bin }} gateway start --system --all
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
# Give the gateway time to start before reporting failure
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
