# Managed by Ansible (mini/ansible/roles/llamacpp) — do not edit by hand.
#
# Podman quadlet for the "{{ item.name }}" llama.cpp server: {{ item.alias }} on :{{ item.port }}.
# systemd generates llama-{{ item.name }}.service from this at daemon-reload.
#
# WHY A QUADLET AND NOT `distrobox enter`. distrobox is a podman-exec client, so
# the unit's cgroup held only that client while llama-server lived in the
# container's cgroup. systemd could not stop it: `systemctl --user stop` returned
# success while the server kept running and holding its port, and the next start
# collided with an invisible survivor. Here llama-server IS the container's main
# process, so stop/restart work normally and no host-side pkill is needed.
#
# The toolbox image is still the right image — it carries the gfx1151-patched
# Mesa/RADV userspace and a llama.cpp built against it. It is an ordinary OCI
# image (empty entrypoint, Cmd=/bin/bash); distrobox was only ever ergonomics.
[Unit]
Description=llama.cpp [{{ item.name }}] {{ item.alias }} on :{{ item.port }}
After=network-online.target
Wants=network-online.target
# PartOf makes `systemctl --user stop {{ llamacpp_target }}` actually stop this
# instance. WantedBy alone would start them as a group but leave them running.
PartOf={{ llamacpp_target }}

[Container]
ContainerName=llama-{{ item.name }}
Image={{ item.image | default(llamacpp_image) }}
# llama-server directly as PID 1 of the container — this is what makes systemd
# able to stop it.
Entrypoint={{ item.entrypoint | default('/usr/bin/llama-server') }}

# Host networking: ports bound here are real ports on mini, matching how the
# toolbox behaved and keeping mini's UFW (tailnet-only) the single control point.
# Switch to PublishPort= if you ever want these namespaced.
Network=host

# GPU passthrough. seccomp=unconfined is required by the ROCm/Vulkan userspace —
# it makes ioctls the default profile blocks, and the symptom is not a permission
# error but the GPU silently failing to enumerate. The 0666 modes from
# roles/toolboxes' 70-kfd.rules are what let this work regardless of how uids map
# into the container.
AddDevice=/dev/dri
AddDevice=/dev/kfd
PodmanArgs=--security-opt seccomp=unconfined

# Models read-only: nothing here should ever write to the shared model dir.
Volume={{ llamacpp_models_dir }}:{{ llamacpp_models_dir }}:ro
{% for vol in item.extra_volumes | default([]) %}
Volume={{ vol }}
{% endfor %}

Exec=-m {{ item.model }} \
     --alias {{ item.alias }} \
     --host {{ item.host | default(llamacpp_host) }} \
     --port {{ item.port }} \
     -c {{ item.ctx }} \
     -np {{ item.parallel }} \
     {{ item.base_args | default(llamacpp_base_args) }} \
{% if item.cache_ram is defined or llamacpp_cache_ram %}
     --cache-ram {{ item.cache_ram | default(llamacpp_cache_ram) }} \
{% endif %}
{% if item.cache_reuse | default(llamacpp_cache_reuse) %}
     --cache-reuse {{ item.cache_reuse | default(llamacpp_cache_reuse) }} \
{% endif %}
{% if item.cache_type_k | default('') %}
     --cache-type-k {{ item.cache_type_k }} \
{% endif %}
{% if item.cache_type_v | default('') %}
     --cache-type-v {{ item.cache_type_v }} \
{% endif %}
{% if item.mtp | default(false) | bool %}
{#   The MTP head lives INSIDE the model GGUF for some models (qwen3.6-35b-a3b-mtp)
     and as a SEPARATE file for others (ggml-org's Qwen3.8 conversions ship
     mtp-*.gguf alongside). Bare --spec-type only works for the former: with a
     separate head and no -md, llama.cpp logs "unused tensor ... -- ignoring" and
     runs at raw speed while LOOKING like MTP is on. Set draft_model when the
     head is a separate file. #}
{% if item.draft_model | default('') %}
     -md {{ item.draft_model }} \
{% endif %}
     --spec-type draft-mtp --spec-draft-n-max {{ item.mtp_draft_max | default(1) }} \
{% endif %}
{#   reasoning_budget is the only thinking control this role can rely on across
     models. reasoning_effort is a TEMPLATE feature: qwen3.8-27b's template
     implements it (xhigh/medium/low, raising on anything else) but
     qwen3.6-35b-a3b's has no such knob at all, so passing it there is a silent
     no-op -- verified against both /props templates 2026-08-23.
     --reasoning-budget is enforced by llama.cpp itself and works regardless of
     template. Measured on :8090 the same day: budget 500 cut reasoning from
     ~3058 to ~456 tokens and TRIPLED emitted content (5.7k -> 15.6k chars) on
     an identical prompt, because the answer stopped competing with the trace
     for max_tokens.
     `is defined` rather than `| default('')`: 0 is MEANINGFUL here (end
     thinking immediately) and a falsy test would silently drop it. #}
{% if item.reasoning_budget is defined %}
     --reasoning-budget {{ item.reasoning_budget }} \
{% endif %}
{% if item.chat_template_kwargs | default('') %}
     --chat-template-kwargs '{{ item.chat_template_kwargs | to_json if item.chat_template_kwargs is mapping else item.chat_template_kwargs }}' \
{% endif %}
{% if item.reasoning_budget is defined %}
     --reasoning-budget {{ item.reasoning_budget }} \
{% endif %}
{% if item.extra_args | default('') %}
     {{ item.extra_args }} \
{% endif %}
     --no-webui

# Readiness, not liveness. Model load is 4-12s from a warm page cache and far
# longer cold, so StartPeriod has to cover the worst case or systemd would keep
# restarting a server that was merely still loading.
# NO nested quotes and no explicit /bin/sh. Quadlet splits HealthCmd= on quotes
# before podman ever sees it, so `/bin/sh -c "curl ... || exit 1"` arrived as an
# unterminated string and the check failed EVERY time with
#   /bin/sh: -c: line 1: unexpected EOF while looking for matching `"'
# Health therefore sat at "starting" forever and each boot left a failed
# podman-healthcheck unit behind. podman already runs a non-JSON HealthCmd via
# the shell, and `curl -sf` exits non-zero on connection failure or HTTP error,
# so the wrapper was redundant as well as broken.
HealthCmd=curl -sf http://127.0.0.1:{{ item.port }}/health
HealthInterval={{ llamacpp_health_interval }}
HealthStartPeriod={{ item.health_start_period | default(llamacpp_health_start_period) }}
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec={{ llamacpp_restart_sec }}
# Loading tens of GiB off a cold page cache blows the default 90s.
# Flash-Next UD-Q4_K_XL is ~111 GB — 600s is not enough from a cold cache.
TimeoutStartSec={{ item.timeout_start_sec | default(llamacpp_timeout_start_sec) }}

[Install]
# Both a normal boot start and membership of the group target, so
# `systemctl --user {start,stop} {{ llamacpp_target }}` moves every instance at once.
WantedBy=default.target {{ llamacpp_target }}
