[Unit]
# Managed by Ansible (mini/ansible/roles/llamacpp) — do not edit by hand.
#
# llama-server instance "{{ item.name }}" — {{ item.model | basename }} on :{{ item.port }}.
# Runs INSIDE the {{ item.toolbox | default(llamacpp_toolbox) }} toolbox: distrobox shares the host
# network namespace, so the port bound in the container is a real port on mini.
Description=llama.cpp server [{{ item.name }}] on :{{ item.port }}
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# distrobox is invoked directly rather than through the ~/.local/bin wrapper: the
# wrapper omits --no-tty, and without it `distrobox enter` wants a terminal that
# a systemd service does not have.
ExecStart=/usr/bin/distrobox enter --no-tty --name {{ item.toolbox | default(llamacpp_toolbox) }} -- \
    llama-server \
    -m {{ item.model }} \
    --alias {{ item.alias }} \
    --host {{ item.host | default(llamacpp_host) }} --port {{ item.port }} \
    -c {{ item.ctx }} -np {{ item.parallel }} \
    {{ item.base_args | default(llamacpp_base_args) }} \
{% if item.mtp | default(false) | bool %}
    --spec-type draft-mtp --spec-draft-n-max {{ item.mtp_draft_max | default(1) }} \
{% endif %}
    {{ item.extra_args | default('') }}

# LOAD-BEARING. `distrobox enter` is a `podman exec` client, so this unit's
# cgroup contains only that client — not the llama-server it started, which lives
# in the container's cgroup. systemd therefore cannot stop the real process:
# without this, `systemctl --user stop` returns success while llama-server keeps
# running and holding :{{ item.port }}, and the next start (or `make provision`)
# fails on a port collision against an invisible survivor.
#
# A host-side pkill works because distrobox shares the host PID namespace (as it
# does net and ipc), so the in-container process is visible here. Anchored on the
# full model path so it cannot match another instance on this box — which is why
# two instances must not share a model file. Leading "-" because pkill exits 1
# when nothing matched, the normal case after a clean shutdown.
ExecStopPost=-/usr/bin/pkill -f "^llama-server -m {{ item.model }}"

Restart=on-failure
RestartSec={{ llamacpp_restart_sec }}
# Cold start pulls tens of GiB off disk and warms the container; the default 90s
# start timeout trips on a cold page cache.
TimeoutStartSec=600
TimeoutStopSec=60
KillMode=mixed

[Install]
WantedBy=default.target
