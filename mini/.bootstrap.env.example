# .bootstrap.env — local-only; gitignored; single source of truth for make render
#
# Copy to .bootstrap.env (make init does this) and fill in real values.
# This file drives envsubst substitution of ${PLACEHOLDER} tokens in:
#   autoinstall/user-data.example → autoinstall/user-data
#   ansible/inventory.example.ini → ansible/inventory.ini
#
# Tip: if ser5/.bootstrap.env already has your credentials, copy it here
# and just change HOSTNAME and HOST_IP — username, password, and SSH key are shared.

# ─── Node identity ────────────────────────────────────────────────────────────
USERNAME=YOUR_USERNAME
USER_FULL_NAME="Your Full Name"
HOSTNAME=mini

# ─── Autoinstall credentials ──────────────────────────────────────────────────
# Password hash — generate with:  mkpasswd --method=sha-512  (apt install whois)
# Wrap in single quotes to prevent shell interpretation of $ characters.
PASSWORD_HASH='PLACEHOLDER_SHA512_HASH'

# SSH public key — paste the full line from ~/.ssh/id_ed25519.pub (or equivalent)
SSH_PUBLIC_KEY="PLACEHOLDER_SSH_PUBLIC_KEY"

# ─── Disk paths ───────────────────────────────────────────────────────────────
# Verify with: lsblk -d  (run from the live ISO shell before proceeding)
# This disk will be WIPED by autoinstall.
OS_DISK=/dev/nvme0n1

# ─── Locale / keyboard ───────────────────────────────────────────────────────
TIMEZONE=America/Chicago
LOCALE=en_US.UTF-8
KEYBOARD_LAYOUT=us

# ─── Ansible target ──────────────────────────────────────────────────────────
# IP address of mini after autoinstall completes.
# Check your router's DHCP table or run `ip a` from the mini console.
HOST_IP=PLACEHOLDER_MINI_IP

# ─── Wi-Fi (optional) ────────────────────────────────────────────────────────
# Set these to connect over Wi-Fi during autoinstall and on first boot.
# Leave blank to use wired Ethernet only.
WIFI_SSID=
WIFI_PSK=
