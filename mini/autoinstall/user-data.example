#cloud-config
# Ubuntu Server 26.04 LTS unattended autoinstall (NoCloud).
# 26.04's GA kernel 7.0 clears the gfx1151 (Strix Halo) >= 6.18.4 stability floor.
#
# This is a TEMPLATE. ${PLACEHOLDER} tokens are substituted from .bootstrap.env
# by `make render` (uses envsubst). Never edit autoinstall/user-data directly.
#
# Workflow:
#   1. make init    → create .bootstrap.env from .bootstrap.env.example
#   2. Edit .bootstrap.env (or copy from ser5/.bootstrap.env and change HOSTNAME + HOST_IP)
#   3. make render  → generates autoinstall/user-data and ansible/inventory.ini
#   4. Validate:    cloud-init schema --config-file autoinstall/user-data
autoinstall:
  version: 1

  locale: ${LOCALE}

  keyboard:
    layout: ${KEYBOARD_LAYOUT}
    variant: ""

  identity:
    # cloud-init is static and cannot read Ansible vars. These two MUST match
    # node_hostname / node_user in ansible/group_vars/all.yml.
    hostname: ${HOSTNAME}
    realname: "${USER_FULL_NAME}"
    username: ${USERNAME}
    password: "${PASSWORD_HASH}"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "${SSH_PUBLIC_KEY}"

  network:
    version: 2
    ethernets:
      all-en:
        match:
          name: "en*"
        dhcp4: true
        optional: true
    # >>> WIFI (this whole block is stripped by `make render` when WIFI_SSID is blank) >>>
    wifis:
      wlp99s0:
        dhcp4: true
        optional: true
        access-points:
          "${WIFI_SSID}":
            password: "${WIFI_PSK}"
    # <<< WIFI <<<

  packages:
    - openssh-server

  storage:
    # Explicit config: only disk0 (${OS_DISK}) is referenced.
    # The single NVMe is both OS and data disk — no second disk on this node.
    #
    # BEFORE PROCEEDING: boot the live ISO, open a shell, and run:
    #   lsblk -d
    # Confirm OS_DISK in .bootstrap.env matches the NVMe shown.
    config:
      - type: disk
        id: disk0
        path: ${OS_DISK}
        ptable: gpt
        wipe: superblock-recursive
        grub_device: true
        preserve: false

      # EFI system partition — 1 GB (generous; holds multiple kernel generations)
      - type: partition
        id: part-efi
        device: disk0
        number: 1
        size: 1G
        flag: boot
        grub_device: true
        preserve: false

      - type: format
        id: fmt-efi
        volume: part-efi
        fstype: fat32
        preserve: false

      - type: mount
        id: mnt-efi
        device: fmt-efi
        path: /boot/efi

      # Root partition — remainder of OS disk
      - type: partition
        id: part-root
        device: disk0
        number: 2
        size: -1
        grub_device: false
        preserve: false

      - type: format
        id: fmt-root
        volume: part-root
        fstype: ext4
        label: ubuntu-root
        preserve: false

      - type: mount
        id: mnt-root
        device: fmt-root
        path: /

  late-commands:
    # Grant passwordless sudo so Ansible can run without a become password.
    - echo '${USERNAME} ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/${USERNAME}
    - chmod 440 /target/etc/sudoers.d/${USERNAME}
