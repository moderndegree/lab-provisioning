# ─── Operator-specific local files — NEVER commit these ──────────────────────
# Generated by make init / make render; hold real credentials and IPs.
.bootstrap.env
autoinstall/user-data
ansible/inventory.ini

# ─── Vault password files — NEVER commit ─────────────────────────────────────
.vault_pass
vault_password_file
*.vault_pass

# ─── Ansible runtime ──────────────────────────────────────────────────────────
*.retry
.ansible/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/
*.swp
*~
